# do not edit this file, it will be overwritten on update
ACTION!="add|change|move|bind", GOTO="mm_chromiumos_end"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2cb7", GOTO="mm_chromiumos_fibocom"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="33f8", GOTO="mm_chromiumos_rolling"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2c7c", GOTO="mm_chromiumos_quectel"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3731", GOTO="mm_chromiumos_netprisma"
SUBSYSTEMS=="pci", SUBSYSTEM=="wwan", ATTRS{vendor}=="0x14c3", GOTO="mm_chromiumos_mtk"
GOTO="mm_chromiumos_end"

#-------------------------------------------------------------------------------
LABEL="mm_chromiumos_fibocom"
SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.MM_USBIFNUM}="$attr{bInterfaceNumber}"

# Fibocom L850-GL
#  cdc-wdm0 (if #0): flagged as required control port
#  ttyACM0 (if #2): AT port, used by modemfwd (ignored in MM)
#  ttyACM2 (if #6): AT port, used by ModemManager
ATTRS{idVendor}=="2cb7", ATTRS{idProduct}=="0007", ENV{.MM_USBIFNUM}=="00", ENV{ID_MM_REQUIRED}="1"
ATTRS{idVendor}=="2cb7", ATTRS{idProduct}=="0007", ENV{.MM_USBIFNUM}=="02", ENV{ID_MM_PORT_IGNORE}="1"

# Fibocom NL668-AM
#  cdc-wdm0 (if #0): flagged as required control port
#  ttyUSB0 (if #2): AT port, used by modemfwd (ignored in MM)
#  ttyUSB1 (if #3): AT port, used by ModemManager
#  ttyUSB2 (if #4): debug port (ignored already)
ATTRS{idVendor}=="2cb7", ATTRS{idProduct}=="01a0", ENV{.MM_USBIFNUM}=="00", ENV{ID_MM_REQUIRED}="1"
ATTRS{idVendor}=="2cb7", ATTRS{idProduct}=="01a0", ENV{.MM_USBIFNUM}=="02", ENV{ID_MM_PORT_IGNORE}="1"

# Fibocom FM101-GL
#  cdc-wdm0 (if #0): flagged as required control port
ATTRS{idVendor}=="2cb7", ATTRS{idProduct}=="01a2", ENV{.MM_USBIFNUM}=="00", ENV{ID_MM_REQUIRED}="1"

GOTO="mm_chromiumos_end"
#-------------------------------------------------------------------------------
LABEL="mm_chromiumos_rolling"
SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.MM_USBIFNUM}="$attr{bInterfaceNumber}"

# Rolling Wireless RW101-GL
#  cdc-wdm0 (if #0): flagged as required control port
ATTRS{idVendor}=="33f8", ATTRS{idProduct}=="01a2", ENV{.MM_USBIFNUM}=="00", ENV{ID_MM_REQUIRED}="1"

# Rolling Wireless RW135
#  cdc-wdm0 (if #0): flagged as required control port
ATTRS{idVendor}=="33f8", ATTRS{idProduct}=="0115", ENV{.MM_USBIFNUM}=="00", ENV{ID_MM_REQUIRED}="1"

GOTO="mm_chromiumos_end"
#-------------------------------------------------------------------------------
LABEL="mm_chromiumos_quectel"
SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.MM_USBIFNUM}="$attr{bInterfaceNumber}"

# Quectel EM060
#  cdc-wdm0 (if #0): flagged as required control port
ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0128", ENV{.MM_USBIFNUM}=="00", ENV{ID_MM_REQUIRED}="1"

GOTO="mm_chromiumos_end"
#-------------------------------------------------------------------------------
LABEL="mm_chromiumos_netprisma"
SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.MM_USBIFNUM}="$attr{bInterfaceNumber}"

# Netprisma LCUK54-WWD
#  cdc-wdm0 (if #0): flagged as required control port
ATTRS{idVendor}=="3731", ATTRS{idProduct}=="0100", ENV{.MM_USBIFNUM}=="00", ENV{ID_MM_REQUIRED}="1"

GOTO="mm_chromiumos_end"
#-------------------------------------------------------------------------------
LABEL="mm_chromiumos_mtk"

# Fibocom FM350
#  wwan0mbim0: MBIM port, flagged as required control port
#  wwan0at0: AT port, ignored as no AT specific needs
ATTRS{vendor}=="0x14c3", ATTRS{device}=="0x4d75", ATTR{type}=="MBIM", ENV{ID_MM_REQUIRED}="1"
ATTRS{vendor}=="0x14c3", ATTRS{device}=="0x4d75", ATTR{type}=="AT", ENV{ID_MM_PORT_IGNORE}="1"

LABEL="mm_chromiumos_end"
